// ==========================================================
// Edison Duel Simulator — schema Prisma (MVP: auth + deck builder + economia + loja)
// Motor de duelo (ocgcore) e modelos de Match/Replay ficam prontos aqui
// para quando a fase de duelo automático for implementada.
// ==========================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- CARTAS / BANLIST ----------------

model Card {
  id          Int     @id
  name        String
  type        String
  race        String?
  attribute   String?
  atk         Int?
  def         Int?
  level       Int?
  description String
  imageUrl    String?
  releaseDate DateTime? // lançamento no TCG (YGOPRODeck misc_info.tcg_date)
  // Quando a carta entrou no jogo. Vazio = entrou até o lançamento do site (todas
  // essas contam como a mesma data). Ver src/lib/site.ts
  siteAddedAt DateTime?
  // Carta que já existe no banco mas ainda não foi lançada no jogo (fora da loja).
  // Lança pelo Admin (aba Lançamentos), na hora ou num lançamento programado.
  released    Boolean   @default(true)
  releaseId   String?
  release     CardRelease? @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  banlistEntries BanlistEntry[]
  banlistExtras  BanlistExtraCard[]
  deckCards      DeckCard[]
  structureCards StructureDeckCard[]
  shopListing    ShopListing?
  ownerships     UserCardOwnership[]
  purchases      Purchase[]
  sales          CardSale[]
  userVariants   UserCardVariant[]

  @@index([name])
}

model BanlistEntry {
  id     String @id @default(cuid())
  cardId Int
  card   Card   @relation(fields: [cardId], references: [id])
  format String
  status String // forbidden | limited | semi-limited | unlimited

  @@unique([cardId, format])
}

// ---------------- USUÁRIO / AUTH ----------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  role          String    @default("player") // player | admin (ver src/lib/admin.ts)
  // Suspensão aplicada pelo Admin (null = conta liberada; ano 9999 = permanente)
  suspendedUntil   DateTime?
  suspensionReason String?
  // VIP: vantagens (ex.: +30% de gold nos duelos) enquanto vipUntil estiver no futuro
  vipUntil         DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  lastLoginIp      String?

  accounts Account[]
  sessions Session[]

  decks                Deck[]
  matchesAsPlayer      MatchPlayer[]
  wallet               Wallet?
  currencyTransactions CurrencyTransaction[]
  payments             Payment[]
  ownerships           UserCardOwnership[]
  purchases            Purchase[]
  cardSales            CardSale[]
  cardVariants         UserCardVariant[]
  items                UserItem[]
  itemTransactions     ItemTransaction[]
  punishments          Punishment[]
  tournamentEntries    TournamentEntry[]
  trophies             Trophy[]
  sentMessages         DirectMessage[] @relation("sentMessages")
  receivedMessages     DirectMessage[] @relation("receivedMessages")
  clanMessages         ClanMessage[]
  reportsMade          PlayerReport[]  @relation("reportsMade")
  reportsReceived      PlayerReport[]  @relation("reportsReceived")
  cosmetics            UserCosmetic[]
  equippedCosmetics    UserEquippedCosmetic[]
  queueEntries         MatchQueueEntry[]
  competitionResults   CompetitionResult[]
  newsComments         NewsComment[]
  newsReactions        NewsCommentReaction[]
  clanMembership       ClanMember?
  clanJoinRequests     ClanJoinRequest[]
  structurePurchases   StructureDeckPurchase[]
  newsPosts            NewsPost[]
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

// ---------------- DECKS ----------------

model Deck {
  id         String     @id @default(cuid())
  name       String
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  format     String     @default("edison")
  isEquipped Boolean    @default(false)
  // Aparência deste deck no duelo (vazio = usa a da conta, em Minha conta → Personalizar)
  sleeveId   String?
  sleeve     Cosmetic?  @relation("DeckSleeve", fields: [sleeveId], references: [id], onDelete: SetNull)
  playmatId  String?
  playmat    Cosmetic?  @relation("DeckPlaymat", fields: [playmatId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  cards      DeckCard[]

  @@unique([userId, name])
  @@index([userId, isEquipped])
}

model DeckCard {
  id       String @id @default(cuid())
  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card   @relation(fields: [cardId], references: [id])
  section  String // main | extra | side
  quantity Int

  @@unique([deckId, cardId, section])
}

// ---------------- PARTIDAS (preparado para fase futura) ----------------

model Match {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  format        String    @default("edison") // no Random: sala do duelo (slifer | obelisk)
  status        String    @default("waiting") // waiting | active | finished | cancelled
  currentTurn   Int       @default(0)
  currentPhase  String    @default("waiting")
  engineState   Json?
  rpsRound      Int       @default(1)
  rpsDeadline   DateTime?
  rpsWinnerId   String?
  firstPlayerId String?

  // Duelo de torneio (sala do torneio); vazio = Random
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  // Torneio em chaves: duelo N de um confronto melhor de 3
  seriesId     String?
  series       TournamentSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  gameNumber   Int?
  opensAt      DateTime? // fim da tela de espera (se os dois entrarem antes, começa na hora)
  woAt         DateTime? // quem não entrou até aqui perde este duelo por W.O.
  // Quando os pontos e o gold do fim da partida foram gravados (evita pagar duas vezes)
  settledAt    DateTime?
  // Relógio do duelo: tempo de cada jogador (3:30 + bônus). Ver src/lib/duel/clock.ts
  clock        Json?

  players MatchPlayer[]
  actions GameAction[]
  replay  Replay?

  @@unique([seriesId, gameNumber])
  @@index([status, createdAt])
}

model MatchPlayer {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  deckId     String
  result     String? // win | loss | draw (definido pelo motor de duelo)
  points     Int? // pontos desta partida (tabela do Admin no momento do fim)
  goldEarned Int? // gold pago ao fim (base + bônus de evento)
  rpsChoice  String?
  lastSeenAt DateTime @default(now())
  joinedAt   DateTime? // torneio em chaves: entrou na sala do duelo

  @@unique([matchId, userId])
  @@index([matchId])
  @@index([lastSeenAt])
}

model GameAction {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  turn      Int
  sequence  Int
  actorId   String
  payload   Json
  createdAt DateTime @default(now())

  @@index([matchId, turn, sequence])
}

model Replay {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id])
  data      Json
  createdAt DateTime @default(now())
}

// ---------------- ECONOMIA ----------------

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  gold      Int      @default(0)
  cash      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CurrencyTransaction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  currency     String // gold | cash
  amount       Int
  balanceAfter Int
  reason       String // match_win | match_loss | shop_purchase | cash_topup | tournament_prize | refund
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@unique([refType, refId, reason, userId])
  @@index([userId, createdAt])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  provider          String
  providerPaymentId String   @unique
  amountCents       Int
  currencyCode      String
  cashGranted       Int
  status            String
  createdAt         DateTime @default(now())
}

// ---------------- LOJA ----------------

model ShopListing {
  id        String  @id @default(cuid())
  cardId    Int     @unique
  card      Card    @relation(fields: [cardId], references: [id])
  priceGold Int?
  priceCash Int?
  cashOnly  Boolean @default(false)
  active    Boolean @default(true)

  maxTotal Int @default(3) // Limite geral da carta (ex: 1 para limitadas)
  maxGold  Int @default(2) // Quantas das primeiras cópias podem ser compradas com Gold (0 = só crédito)
  maxCash  Int @default(3) // Quantas cópias pode comprar com Cash

  // Preço definido à mão no painel do Admin: "aplicar preços da categoria" não mexe nesta carta
  customPrice Boolean @default(false)
}

model UserCardOwnership {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  cardId   Int
  card     Card   @relation(fields: [cardId], references: [id])
  quantity Int    @default(0)

  @@unique([userId, cardId])
}

model Purchase {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  cardId       Int
  card         Card     @relation(fields: [cardId], references: [id])
  currencyUsed String
  amountPaid   Int
  finish       String   @default("normal") // raridade da cópia comprada (normal | rara | ultra | secreta)
  border       String   @default("none") // borda da cópia comprada (none | prata | ouro)
  createdAt    DateTime @default(now())
}

// Venda de cartas na loja: uma linha por cópia vendida.
// origin = de onde a cópia tinha vindo (gold | cash = compra na loja; free = prêmio/presente).
// Serve para saber quantas cópias de cada origem ainda restam. Regras em src/lib/card-sale-rules.ts
model CardSale {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    Int
  card      Card     @relation(fields: [cardId], references: [id])
  origin    String // gold | cash | free
  currency  String // moeda recebida: gold | cash
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId, cardId])
}

// Configurações do jogo que o Admin muda pelo painel (ex.: "card_sale_percent" = "40").
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String? // id do admin que mudou por último
}

// ======================= PERSONALIZAÇÃO (COSMÉTICOS) =======================
// Itens de personalização (sleeves, playmats, molduras...). O jogador só pode
// equipar itens que possui; eles são dados, premiados ou vendidos pelo jogo.

model Cosmetic {
  id          String   @id @default(cuid())
  type        String // sleeve | playmat | frame | name_style (ver src/lib/cosmetic-types.ts)
  name        String
  description String?
  imageUrl    String?
  effect      String? // só para name_style: id do efeito (gold, rainbow...) — ver NAME_EFFECTS
  rarity      String   @default("common") // common | rare | epic | legendary
  priceGold   Int? // null = não vendido com gold
  priceCash   Int? // null = não vendido com crédito
  // Vitrine da aba Cosméticos da loja (o Admin coloca); trancado até shopUnlockAt
  inShop       Boolean   @default(false)
  shopUnlockAt DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  owners   UserCosmetic[]
  equipped UserEquippedCosmetic[]

  // Preenchido quando o item é exclusivo da versão premium de um Structure Deck
  structureDeckId String?
  structureDeck   StructureDeck? @relation(fields: [structureDeckId], references: [id], onDelete: SetNull)

  @@index([type])
  decksAsSleeve  Deck[] @relation("DeckSleeve")
  decksAsPlaymat Deck[] @relation("DeckPlaymat")
}

model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId String
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id])
  source     String // grant | raffle | reward | purchase
  acquiredAt DateTime @default(now())

  @@unique([userId, cosmeticId])
}

model UserEquippedCosmetic {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  cosmeticId String
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id])

  @@id([userId, type])
}

// ======================= RANDOM (FILA DE DUELOS) =======================
// Um jogador pode aguardar em uma ou mais salas ao mesmo tempo (uma linha por
// sala). Quando o duelo é encontrado, todas as linhas dele são removidas.

model MatchQueueEntry {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room       String // slifer | obelisk (ver src/lib/duel-rooms.ts)
  deckId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // atualizado pelo polling; entradas antigas são ignoradas

  @@unique([userId, room])
  @@index([room, createdAt])
}

// ======================= RANKING / SEASONS / COMPETIÇÕES =======================

// Período de uma season. A season atual é a que contém a data de hoje.
model Season {
  id       String   @id @default(cuid())
  name     String
  startsAt DateTime @unique
  endsAt   DateTime // exclusivo: a season vale até antes deste instante

  @@index([startsAt, endsAt])
}

// Uma competição (torneio, evento...). Os pontos contam no período em que ela aconteceu.
model Competition {
  id          String              @id @default(cuid())
  name        String
  description String?
  heldAt      DateTime
  createdAt   DateTime            @default(now())
  results     CompetitionResult[]
  newsPost    NewsPost?

  @@index([heldAt])
}

model CompetitionResult {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement     Int? // colocação final (1 = campeão)
  points        Int

  @@unique([competitionId, userId])
  @@index([userId])
}

// ======================= JORNAL / CALENDÁRIO =======================

model NewsPost {
  id            String        @id @default(cuid())
  type          String // news (notícia) | notice (aviso) | tournament (resultado de torneio)
  title         String
  summary       String?
  content       String // texto puro; parágrafos separados por linha em branco
  imageUrl      String?
  pinned        Boolean       @default(false) // fixado no topo do jornal
  competitionId String?       @unique // preenchido nas publicações automáticas de torneio
  competition   Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  // Quem publicou (Admin). null nas publicações automáticas de torneio
  authorId      String?
  author        User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt   DateTime      @default(now())
  comments      NewsComment[]

  @@index([publishedAt])
}

model NewsComment {
  id        String                @id @default(cuid())
  postId    String
  post      NewsPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Respostas ficam em um nível só: respondendo a uma resposta, ela entra no mesmo comentário principal
  parentId  String?
  parent    NewsComment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   NewsComment[]         @relation("CommentReplies")
  content   String
  createdAt DateTime              @default(now())
  deletedAt DateTime? // apagado pelo autor: some o texto, ficam as respostas
  reactions NewsCommentReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model NewsCommentReaction {
  commentId String
  comment   NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int // 1 = like, -1 = deslike

  @@id([commentId, userId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        String    @default("event") // tournament | event | update | other
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

// ======================= CLÃS =======================
// Regras de cargos e permissões: src/lib/clans/roles.ts

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Cofre do clã: recebe 10% dos ganhos dos membros (sem tirar deles), doações e prêmios
  vaultGold   Int      @default(0)
  vaultCash   Int      @default(0)
  createdAt   DateTime @default(now())

  members           ClanMember[]
  joinRequests      ClanJoinRequest[]
  actionRequests    ClanActionRequest[]
  vaultTransactions ClanVaultTransaction[]
  tournaments       ClanTournament[]
  messages          ClanMessage[]
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId   String   @unique // um clã por jogador
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // leader | vice | sub | captain | member
  joinedAt DateTime @default(now())

  @@index([clanId])
}

// Pedido de entrada (o jogador pede) ou convite (o clã convida)
model ClanJoinRequest {
  id          String   @id @default(cuid())
  clanId      String
  clan        Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // request | invite
  invitedById String?
  createdAt   DateTime @default(now())

  @@unique([clanId, userId])
  @@index([userId])
}

// Decisão que depende de aprovação (ex.: vice distribuindo o cofre). Se ninguém
// responder até expiresAt, é executada automaticamente.
model ClanActionRequest {
  id            String    @id @default(cuid())
  clanId        String
  clan          Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  type          String // settings | kick | change_role | distribute | tournament_create | tournament_finalize | tournament_cancel
  payload       Json
  summary       String // descrição legível do que será feito
  requesterId   String
  targetUserId  String?
  approverRoles String // cargos que podem aceitar/recusar, separados por vírgula (ex.: "leader,vice")
  // true: sem resposta até expiresAt, é executada (pedidos do vice e dos capitães).
  // false: sem resposta, expira sem executar (pedidos dos sub-líderes).
  autoExecute   Boolean   @default(true)
  status        String    @default("pending") // pending | executing | executed | rejected | expired | failed
  expiresAt     DateTime
  decidedById   String? // null quando executado automaticamente pelo prazo
  decidedAt     DateTime?
  resultMessage String?
  createdAt     DateTime  @default(now())

  @@index([clanId, status])
  @@index([status, expiresAt])
}

// Histórico do cofre. Valores positivos entram, negativos saem.
model ClanVaultTransaction {
  id           String   @id @default(cuid())
  clanId       String
  clan         Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId       String? // quem contribuiu (entradas) ou recebeu (saídas)
  currency     String // gold | cash
  amount       Int
  balanceAfter Int
  reason       String // ver VAULT_REASONS em src/lib/clans/roles.ts
  refType      String?
  refId        String?
  createdAt    DateTime @default(now())

  @@index([clanId, createdAt])
  @@index([clanId, userId])
}

model ClanTournament {
  id          String    @id @default(cuid())
  clanId      String
  clan        Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startsAt    DateTime
  status      String    @default("open") // open | finished | cancelled
  prizes      Json // [{ placement, gold, cash }] — reservado do cofre na criação
  results     Json? // [{ placement, userId }]
  createdById String
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([clanId, status])
}

// ======================= STRUCTURE DECKS (LOJA) =======================
// Deck pronto vendido em duas versões: base e premium (base + cosméticos
// exclusivos: sleeves, playmat e moldura — os Cosmetic com structureDeckId).

model StructureDeck {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  coverCardId Int? // carta cuja arte ilustra o deck na loja
  active      Boolean @default(true)

  // Preços da versão base (null = não vendido nessa moeda)
  priceCash Int?
  priceGold Int?
  // Versão premium
  premiumPriceCash Int?
  premiumPriceGold Int?
  // Dinheiro real (centavos de R$), preço cheio; o desconto é aplicado por cima
  moneyPriceCents        Int?
  premiumMoneyPriceCents Int?
  moneyDiscountPercent   Int  @default(0)
  // Preço em gold + crédito = valor das cartas avulsas (o que pagaria comprando uma a uma) com este desconto
  discountPercent        Int  @default(30)
  // Itens que acompanham a versão premium, ex.: [{ "item": "po_milenio_raro", "quantity": 2 }]
  premiumItems           Json?

  createdAt DateTime @default(now())

  cards     StructureDeckCard[]
  cosmetics Cosmetic[]
  purchases StructureDeckPurchase[]
}

model StructureDeckCard {
  id              String        @id @default(cuid())
  structureDeckId String
  structureDeck   StructureDeck @relation(fields: [structureDeckId], references: [id], onDelete: Cascade)
  cardId          Int
  card            Card          @relation(fields: [cardId], references: [id])
  section         String // main | extra | side
  quantity        Int
  // Raridade das cópias que vêm no deck (normal | rara | ultra | secreta)
  finish          String        @default("normal")

  @@unique([structureDeckId, cardId, section])
}

model StructureDeckPurchase {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  structureDeckId String
  structureDeck   StructureDeck @relation(fields: [structureDeckId], references: [id])
  edition         String // base | premium
  currency        String // gold+cash (os dois juntos) | money | cash | gold (compras antigas)
  amountPaid      Int // gold (ou a única moeda, nas compras antigas)
  amountCash      Int           @default(0) // crédito pago junto com o gold
  createdAt       DateTime      @default(now())

  @@index([userId, structureDeckId])
}

// ======================= RARIDADES / ITENS =======================
// UserCardOwnership continua sendo o TOTAL de cópias de cada carta. Aqui ficam
// só as cópias evoluídas (raridade e/ou borda); o resto é Normal sem borda.
// Regras e itens: src/lib/card-finish.ts

model UserCardVariant {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card   @relation(fields: [cardId], references: [id])
  finish   String // normal | rara | ultra | secreta
  border   String // none | prata | ouro
  quantity Int

  @@unique([userId, cardId, finish, border])
  @@index([userId, cardId])
}

// Inventário de itens (Pó do Milênio, molduras...). Catálogo em src/lib/card-finish.ts
model UserItem {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Int    @default(0)

  @@id([userId, itemKey])
}

model ItemTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String
  amount    Int // positivo = ganhou, negativo = usou
  reason    String // prize | event | structure_premium | deposit | evolve | admin
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ======================= PAINEL DO ADMIN =======================

// Histórico de tudo o que o Admin envia (gold, crédito, cartas, cosméticos, itens)
model AdminGrant {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String
  kind         String // currency | card | cosmetic | item
  summary      String // descrição legível, ex.: "500 gold" ou "2x Dark Magician (Rara)"
  reason       String // prize | event | compensation | gift
  note         String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}

// Punições aplicadas pelo Admin (todas exigem a senha de punição)
model Punishment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId        String
  type           String // warning | suspension | unsuspend | remove_gold | remove_cash | remove_cards | wipe_cards
  reason         String
  summary        String // o que foi feito, ex.: "Suspensa por 7 dias" ou "Retirados 500 gold"
  until          DateTime? // fim da suspensão
  acknowledgedAt DateTime? // advertência: quando o jogador clicou em "Entendi"
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
}

// ======================= TORNEIOS, TROFÉUS E EVENTOS =======================

// Torneio criado pelo Admin. Os inscritos duelam numa sala própria entre startsAt
// e endsAt; cada duelo vale os pontos do tipo (oficial ou rápido). Ao encerrar,
// a classificação dá troféus e os prêmios de cada colocação.
model Tournament {
  id          String            @id @default(cuid())
  name        String
  description String?
  type        String // official | quick
  format      String            @default("obelisk") // banlist da sala: slifer | obelisk
  startsAt    DateTime
  endsAt      DateTime
  // Prêmios por colocação: [{ placement, rewards: [GrantPayload...] }] (ver src/lib/tournaments.ts)
  prizes      Json              @default("[]")
  status      String            @default("open") // open | finished | cancelled
  finishedAt  DateTime?
  createdById String
  createdAt   DateTime          @default(now())

  // Formato: points (duelos na sala do torneio somam pontos) | bracket (chaves, melhor de 3)
  structure    String    @default("points")
  maxEntrants  Int? // vagas (chaves)
  clockSeconds Int       @default(300) // tempo de cada jogador para entrar no duelo (W.O. ao zerar)
  activatedAt  DateTime? // chaves: o Admin ativou (os duelos abrem nos horários das chaves)
  pausedAt     DateTime? // chaves: pausado (nenhum duelo novo abre)

  entries TournamentEntry[]
  matches Match[]
  stages  TournamentStage[]
  series  TournamentSeries[]

  @@index([status, startsAt])
}

// Etapa de um torneio em chaves: Chave A, Chave B e a Final, cada uma com seu horário
model TournamentStage {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  key          String // A | B | final
  name         String
  startsAt     DateTime

  @@unique([tournamentId, key])
}

// Um confronto melhor de 3 dentro das chaves
model TournamentSeries {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stageKey     String // A | B | final
  round        Int // 1 = primeira rodada da chave
  slot         Int // posição na rodada
  playerAId    String?
  playerBId    String?
  winsA        Int        @default(0)
  winsB        Int        @default(0)
  winnerId     String?
  status       String     @default("pending") // pending | live | finished
  // Quem avança: vai para nextSeriesId no lado nextSide (A ou B)
  nextSeriesId String?
  nextSide     String?
  chooserId    String? // quem escolhe quem começa no próximo duelo
  createdAt    DateTime   @default(now())

  matches Match[]

  @@index([tournamentId, stageKey, round])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement    Int? // colocação final (preenchida ao encerrar)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
}

// Estante de troféus do perfil
model Trophy {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // official | quick | weekly | season | special
  title     String // ex.: "Torneio Oficial de Setembro"
  placement Int? // 1, 2, 3...
  refType   String?
  refId     String?
  awardedAt DateTime @default(now())

  @@index([userId, awardedAt])
}

// Evento de gold: cada duelo no período paga um bônus extra de gold
model GoldEvent {
  id          String   @id @default(cuid())
  name        String
  bonusGold   Int
  startsAt    DateTime
  endsAt      DateTime
  newsPostId  String? // anúncio publicado no jornal
  createdById String
  createdAt   DateTime @default(now())

  @@index([startsAt, endsAt])
}

// Fechamento de um período do ranking de Pontos (semana ou season): quem fez
// mais pontos ganha troféu e prêmio. Uma linha por período (não paga em dobro).
model RankingClosing {
  id         String   @id @default(cuid())
  kind       String // week | season
  periodKey  String // semana: início em ISO; season: id da season
  startsAt   DateTime
  endsAt     DateTime
  newsPostId String?
  closedAt   DateTime @default(now())

  @@unique([kind, periodKey])
  @@index([kind, endsAt])
}

// Mensagem privada entre dois jogadores (aba Mensagens)
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("receivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime? // null = ainda não lida por quem recebeu

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

// Chat privado do clã (só membros leem e escrevem)
model ClanMessage {
  id        String    @id @default(cuid())
  clanId    String
  clan      Clan      @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([clanId, createdAt])
}

// Denúncia feita no perfil de um jogador (o Admin analisa na aba Denúncias)
model PlayerReport {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     User      @relation("reportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId     String
  target       User      @relation("reportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  reason       String // offense | cheating | name | spam | scam | other
  message      String
  status       String    @default("open") // open | resolved | dismissed
  adminNote    String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetId, status])
  @@index([reporterId, createdAt])
}

// Banlists do jogo: uma por sala (slifer, obelisk) e as próprias de torneios.
// As cartas ficam em BanlistEntry (format = id desta tabela).
model Banlist {
  id          String   @id // slug: "slifer", "obelisk", "torneio-de-halloween"...
  name        String
  kind        String   @default("tournament") // room | tournament
  description String?
  // Cartas que existem nesta banlist: lançadas no TCG até esta data + as extras (BanlistExtraCard).
  // Vazio = todas as cartas do jogo.
  poolUntil   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Mudança de banlist feita no Admin (para o anúncio no Jornal listar o que mudou)
model BanlistChange {
  id          String    @id @default(cuid())
  format      String
  cardId      Int
  fromStatus  String // forbidden | limited | semi-limited | unlimited
  toStatus    String
  adminId     String
  createdAt   DateTime  @default(now())
  announcedAt DateTime?

  @@index([format, announcedAt])
}

// Carta liberada numa banlist fora da data do pool (ex.: XYZ na Obelisco, adições da Slifer)
model BanlistExtraCard {
  id     String @id @default(cuid())
  format String
  cardId Int
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([format, cardId])
}

// Lançamento programado de cartas (ex.: "Aesir vs os Cavaleiros da Constelação").
// Na data, as cartas entram na loja; a promoção vale nas primeiras horas.
model CardRelease {
  id              String    @id @default(cuid())
  name            String
  description     String?
  releaseAt       DateTime? // vazio = ainda sem data
  promoPercent    Int       @default(0) // desconto na loja durante a promoção
  promoHours      Int       @default(0) // duração da promoção a partir do lançamento
  releasedAt      DateTime?
  calendarEventId String?
  newsPostId      String?
  createdAt       DateTime  @default(now())

  cards Card[]
}

// ======================= PASSE DE BATALHA =======================
// Temporada mensal com 50 níveis: trilha grátis e trilha Premium (paga em crédito).
// XP vem dos duelos e das missões diárias/semanais (src/lib/battle-pass.ts).
model BattlePass {
  id               String   @id @default(cuid())
  name             String // ex.: "Temporada 1 · O Despertar do Faraó"
  description      String?
  artCardId        Int? // arte do topo (carta)
  startsAt         DateTime
  endsAt           DateTime
  levels           Int      @default(50)
  xpPerLevel       Int      @default(500)
  xpWin            Int      @default(100) // XP por duelo vencido
  xpLoss           Int      @default(40) // XP por duelo perdido (jogar também conta)
  premiumPriceCash Int      @default(300)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  rewards  BattlePassReward[]
  progress BattlePassProgress[]
}

// Prêmio de um nível numa trilha (free | premium). reward = GrantPayload ou { kind: "mystery_card" }
model BattlePassReward {
  id     String     @id @default(cuid())
  passId String
  pass   BattlePass @relation(fields: [passId], references: [id], onDelete: Cascade)
  level  Int
  track  String // free | premium
  reward Json

  @@unique([passId, level, track])
}

model BattlePassProgress {
  id        String     @id @default(cuid())
  passId    String
  pass      BattlePass @relation(fields: [passId], references: [id], onDelete: Cascade)
  userId    String
  xp        Int        @default(0)
  premium   Boolean    @default(false)
  premiumAt DateTime?
  createdAt DateTime   @default(now())

  claims BattlePassClaim[]

  @@unique([passId, userId])
}

// Prêmio já resgatado (um por nível e trilha)
model BattlePassClaim {
  id         String             @id @default(cuid())
  progressId String
  progress   BattlePassProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  level      Int
  track      String
  summary    String // o que o jogador recebeu (ex.: "Carta surpresa: Jinzo (Ultra)")
  claimedAt  DateTime           @default(now())

  @@unique([progressId, level, track])
}

// Missão resgatada num período (dia ou semana)
model BattlePassMissionClaim {
  id         String   @id @default(cuid())
  passId     String
  userId     String
  missionKey String
  periodKey  String
  xp         Int
  claimedAt  DateTime @default(now())

  @@unique([passId, userId, missionKey, periodKey])
}

// Desafio diário ou missão da conta resgatada (periodKey: dia em Brasília, ou "once" para missões)
model ChallengeClaim {
  id        String   @id @default(cuid())
  userId    String
  key       String
  periodKey String
  summary   String
  claimedAt DateTime @default(now())

  @@unique([userId, key, periodKey])
  @@index([userId])
}
