# Banco de dados
# PostgreSQL obrigatório (SQLite não é mais suportado pelo schema).
# Local: "postgresql://postgres:senha@localhost:5432/edison"
# Nuvem (ex.: Neon): cole a connection string do painel
DATABASE_URL="postgresql://user:password@localhost:5432/edison"

# Auth.js
AUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Envio do código de confirmação
RESEND_API_KEY=""
# Exemplo após verificar seu domínio no Resend:
# RESEND_FROM_EMAIL="Edison Duel Simulator <login@seudominio.com>"
RESEND_FROM_EMAIL=""
# Endereço que receberá os relatórios enviados pela tela de duelo
BUG_REPORT_EMAIL=""

# Motor de duelo OCGCore (somente no servidor)
# `npm run duel:resources` instala os recursos nestes caminhos padrão.
# Só preencha para usar recursos em outro diretório.
OCGCORE_CARD_DB_PATH=""
OCGCORE_SCRIPT_DIR=""

# Pagamentos (fase de cash real — não implementado ainda neste MVP)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Senha exigida pelo painel do Admin para aplicar punições (advertência, suspensão,
# retirar cartas/moedas). Escolha uma senha forte e só o Admin deve saber.
ADMIN_PUNISH_PASSWORD=""

# Data de lançamento do site (ex.: "2026-12-01"). Até lá, toda carta conta como
# "do lançamento"; depois, cada carta nova guarda a data em que entrou no jogo.
SITE_LAUNCH_DATE=""
